{
  "rules": {
    "gateLogs": {
      ".read": "auth != null",
      "$logId": {
        ".write": "auth != null && (!data.exists() || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Super Admin' || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Administrator' || (newData.exists() && data.child('cardId').val() === newData.child('cardId').val() && data.child('cardHex').val() === newData.child('cardHex').val() && data.child('direction').val() === newData.child('direction').val() && data.child('timestamp').val() === newData.child('timestamp').val() && data.child('source').val() === newData.child('source').val()))",
        ".validate": "newData.hasChild('timestamp') && newData.child('timestamp').isNumber() && (!newData.hasChild('direction') || newData.child('direction').val() === 'IN' || newData.child('direction').val() === 'OUT')",

        "imageUrl": {
          ".validate": "newData.val() == '' || newData.val().matches(/^https:\\/\\//)"
        }
      }
    },

    "rfidUsers": {
      ".read": "auth != null",
      "$userId": {
        ".write": "auth != null && (newData.exists() || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Super Admin' || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Administrator')",
        ".validate": "newData.hasChildren(['name', 'rfidId']) && newData.child('name').isString() && newData.child('rfidId').isString()",

        "rfidId": {
          ".validate": "!data.exists() || data.val() === newData.val() || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Super Admin' || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Administrator'"
        },

        "email": {
          ".validate": "newData.val() == '' || newData.val().matches(/^[^@]+@[^@]+\\.[^@]+$/)"
        },

        "phone": {
          ".validate": "newData.val() == '' || newData.val().matches(/^09[0-9]{9}$/)"
        },

        "status": {
          ".validate": "(newData.val() === 'Active' || newData.val() === 'Inactive') && (!data.exists() || data.val() === newData.val() || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Super Admin' || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Administrator')"
        },

        "imageUrl": {
          ".validate": "newData.val() == '' || newData.val().matches(/^https:\\/\\//)"
        }
      }
    },

    "payments": {
      ".read": "auth != null",
      "$paymentId": {
        ".write": "auth != null && (!data.exists() || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Super Admin' || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Administrator')",
        ".validate": "newData.hasChildren(['rfidId', 'amount']) && newData.child('rfidId').isString() && newData.child('amount').isNumber()"
      }
    },

    "adminProfiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['fullName', 'email', 'role', 'status'])",
        "role": {
          ".validate": "(newData.val() === 'Super Admin' || newData.val() === 'Administrator' || newData.val() === 'Security Guard') && (!root.child('adminProfiles').child(auth.uid).child('role').exists() || root.child('adminProfiles').child(auth.uid).child('role').val() === newData.val() || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Super Admin')"
        }
      }
    },

    "settings": {
      "app": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('adminProfiles').child(auth.uid).child('role').val() === 'Super Admin' || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Administrator')",
        ".validate": "newData.hasChild('appName')",

        "gateStatus": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['state', 'updatedAt']) && (newData.child('state').val() === 'OPEN' || newData.child('state').val() === 'CLOSED') && newData.child('updatedAt').isNumber()"
        }
      }
    },

    "users": {
      "system": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('adminProfiles').child(auth.uid).child('role').val() === 'Super Admin' || root.child('adminProfiles').child(auth.uid).child('role').val() === 'Administrator')",
        ".validate": "newData.hasChild('displayName')"
      }
    },

    "smsLogs": {
      ".read": "auth != null",
      ".write": false
    }
  }
}
