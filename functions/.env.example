# Copy to .env (gitignored) to override the Semaphore sender name shown to recipients.
# This is NOT the API key - that's a secret, set separately via:
#   firebase functions:secrets:set SEMAPHORE_API_KEY
SEMAPHORE_SENDER_NAME=SEMAPHORE

# Testing with UniSMS while the Semaphore sender name is pending approval.
# The key is a secret, set separately via: firebase functions:secrets:set UNISMS_API_KEY
# SMS_PROVIDER=unisms
# UNISMS_SENDER_ID=UniSMS
