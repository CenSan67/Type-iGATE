rules_version = '2';

// Firebase Storage rules are a separate product from database.rules.json (Realtime
// Database) - deploy this in Firebase Console -> Storage -> Rules, not the RTDB tab.
service firebase.storage {
  match /b/{bucket}/o {
    match /vehicle-snapshots/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
